[Unit]
Description=V Push ARM IMA sync (production ImaDocumentService.sync_once)
# Wrapper only sets host paths. Secrets stay under host secrets/ — never commit.

[Service]
Type=oneshot
WorkingDirectory=/opt/vpush-ima-lab
Environment=TZ=Asia/Shanghai
Environment=CACHE_ROOT=/data/vpush-ima-cache
Environment=VPUSH_SRC_ROOT=/opt/vpush-ima-lab/src
Environment=VPUSH_PYTHON=/opt/vpush-ima-lab/venv/bin/python
Environment=IMA_PURE_SECRETS_FILE=/opt/vpush-ima-lab/secrets/ima-pure.json
Environment=IMA_PURE_GROUPS_FILE=/opt/vpush-ima-lab/secrets/ima-pure-groups.json
ExecStart=/opt/vpush-ima-lab/bin/ima-lab-sync-all.sh
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
