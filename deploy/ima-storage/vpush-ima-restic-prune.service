[Unit]
Description=V Push IMA archive Restic monthly prune
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/vpush-ima/restic-maintain.sh prune /etc/vpush/ima-storage.env
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
