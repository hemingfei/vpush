[Unit]
Description=V Push ARM CICC sync (production cicc_report_collector incr)
# Same --days 3 as scripts/vps/cicc-dispatch.py. Cookie stays in host secrets/.

[Service]
Type=oneshot
WorkingDirectory=/opt/vpush-ima-lab
Environment=TZ=Asia/Shanghai
Environment=CACHE_ROOT=/data/vpush-ima-cache
Environment=VPUSH_SRC_ROOT=/opt/vpush-ima-lab/src
Environment=VPUSH_PYTHON=/opt/vpush-ima-lab/venv/bin/python
Environment=VPUSH_CICC_COOKIE_FILE=/opt/vpush-ima-lab/secrets/cicc-cookies.txt
Environment=CICC_INCR_DAYS=3
Environment=DRY_RUN=0
ExecStart=/opt/vpush-ima-lab/bin/cicc-lab-sync.sh
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=21600

[Install]
WantedBy=multi-user.target
