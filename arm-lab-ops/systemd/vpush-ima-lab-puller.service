[Unit]
Description=V Push ARM lab puller (staging → hot + 115)
# Lab only. Not production compose. OpenList stays a container.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/vpush-ima-lab
Environment=TZ=Asia/Shanghai
Environment=CACHE_ROOT=/data/vpush-ima-cache
Environment=P115_LAB_ROOT=/vpush
Environment=P115_COOKIES_FILE=/opt/vpush-ima-lab/secrets/115-cookies.txt
Environment=P115_DEVICE_TYPE=harmony
EnvironmentFile=-/data/vpush-ima-cache/ops-puller.env
ExecStart=/opt/vpush-ima-lab/venv/bin/python /opt/vpush-ima-lab/scripts/puller_loop.py
Restart=always
RestartSec=5
UMask=0022
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
