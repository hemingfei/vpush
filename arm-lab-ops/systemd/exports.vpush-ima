# Lab/prod export for ARM incremental tree. Copy onto Oracle-SJ-ARM /etc/exports.d/
# or merge into /etc/exports. Do NOT export 0.0.0.0/0.
#
# Clients: Tailscale CGNAT only. Production DMIT has no Tailscale yet — do not
# remount vpush until a path exists (Tailscale on DMIT, or a new WG peer; the
# current wg-vpush-ima is a /30 to storage only).
/srv/vpush-ima 100.64.0.0/10(rw,sync,all_squash,anonuid=99,anongid=100,no_subtree_check,fsid=10,insecure)
